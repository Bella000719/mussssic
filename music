<!doctype html>
<html lang="zh-Hant"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>06｜音量驅動模擬器（支援真實麥克風）</title>
<style>
:root{font-family:system-ui,"Microsoft JhengHei",sans-serif;color:#203e46;background:#f4f2ec;line-height:1.65}*{box-sizing:border-box}body{margin:0}main{max-width:1350px;margin:auto;padding:24px}h1{font-size:clamp(25px,4vw,36px);margin:4px 0}h2{font-size:20px;margin:0 0 12px}h3{font-size:16px;margin:18px 0 8px}p{margin:7px 0}.small,small{font-size:13px;color:#526b70}.eyebrow{font-size:12px;letter-spacing:.12em;color:#526b70}.layout{display:grid;grid-template-columns:minmax(0,1fr) 350px;gap:20px;align-items:start;margin-top:20px}.panel{background:white;border:1px solid #ccd9d4;border-radius:16px;padding:22px;min-width:0}.game{position:sticky;top:18px;overflow:hidden;border-radius:18px;border:1px solid #ccd9d4;background:#edf2ea;min-width:0}.game svg{display:block;width:100%;height:auto}.caption{background:white;padding:14px 18px;font-size:15px}.buttons{display:flex;gap:8px;flex-wrap:wrap;margin:14px 0}button,select{font:inherit;border:1px solid #286a5c;border-radius:8px;padding:8px 12px}button{background:#286a5c;color:white;cursor:pointer}button.secondary,select{background:white;color:#203e46}select{width:100%}:focus-visible{outline:3px solid #a65d22;outline-offset:4px}label{display:block;font-size:14px;font-weight:bold;margin-top:13px}input[type=range]{width:100%;accent-color:#286a5c}output{float:right}input:disabled{opacity:.45}.reading{display:flex;align-items:center;justify-content:space-between}.reading strong{font-size:34px}.meter{height:22px;background:#e4ebe7;border-radius:5px;position:relative;margin:10px 0 6px}.fill{height:100%;width:0;background:#5f9885;border-radius:5px}.marker{position:absolute;top:-3px;height:28px;border-left:3px solid #344e70}.marker.loud{border-color:#a25732}.legend{display:flex;justify-content:space-between;font-size:12px}.stats{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin:15px 0}.stats div{padding:8px 10px;background:#edf3ef;border-radius:8px;font-size:12px}.stats strong{display:block;font-size:16px}.inputbox{padding:12px;background:#f0f4f0;border-radius:10px;margin:12px 0}.active-key{color:#286a5c;font-weight:bold}details{margin-top:18px}summary{font-weight:bold;cursor:pointer}li{margin:7px 0}.log{font-size:13px;min-height:40px;padding-left:20px}footer{margin-top:20px;font-size:13px;color:#526b70}body.play .debug-only{display:none!important}body.play .layout{grid-template-columns:1fr;margin-top:0}body.play .game{position:static;max-width:1100px;width:100%;margin:auto}body.play .game svg{max-height:85vh}[hidden]{display:none!important}@media(max-width:950px){.layout{grid-template-columns:1fr}.game{position:static}main{padding:18px 14px}}button:disabled{opacity:.45;cursor:not-allowed}
.mic-btn{width:100%;margin-bottom:10px;background:#286a5c;color:#fff;font-weight:bold}
.mic-btn.active{background:#b15c62;border-color:#b15c62}
</style></head><body><main>
<header class="debug-only"><p class="eyebrow">互動教具 · 第四週 · 範例 06</p><h1>音量控制與模擬器（支援麥克風）</h1><p>可用真實麥克風發聲，或使用鍵盤／滑桿模擬音量輸入。</p><p class="small">按下 <strong>[空白鍵 Space]</strong> 可隨時切換「除錯模式」與「全螢幕遊戲模式」。</p></header>
<div class="layout"><section class="game" id="game" tabindex="0" aria-label="聲音模擬遊戲">
<svg viewBox="0 0 1000 650" role="img" aria-label="旋轉方塊受到音量支撐，突然增幅使體換色">
<defs><linearGradient id="sky" x2="0" y2="1"><stop stop-color="#e3ede8"/><stop offset="1" stop-color="#f7f3e9"/></linearGradient></defs><rect width="1000" height="650" fill="url(#sky)"/><circle cx="840" cy="100" r="45" fill="#e7d8b4"/><path d="M0 520 Q200 440 390 510 T760 490 T1000 510 V650 H0Z" fill="#d8e4d8"/>
<g class="debug-only"><line x1="500" x2="500" y1="30" y2="580" stroke="#89a697" stroke-dasharray="6 10"/><text x="25" y="45" fill="#526b70" font-size="19">音量訊號輸入 → 聲音判斷 → 浮力／換色</text></g>
<rect y="580" width="1000" height="70" fill="#c3cdbb"/><line x1="0" x2="1000" y1="580" y2="580" stroke="#6d8c75" stroke-width="4"/><ellipse id="shadow" cx="500" cy="583" rx="45" ry="9" fill="#3f6051" opacity=".18"/>
<g id="cube" transform="translate(500 170)"><rect id="cubeColor" x="-38" y="-38" width="76" height="76" rx="7" fill="#397866"/><path d="M-18 12 L0 -16 L18 12 M0 -14 V22" fill="none" stroke="white" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"/></g>
<text id="feedback" x="500" y="95" text-anchor="middle" font-size="25" fill="#2c5d50">對麥克風發聲或按住 ↑，托住方塊</text><text id="sceneHint" x="500" y="623" text-anchor="middle" font-size="19" fill="#3e5c47">對麥克風發聲 / 按住 ↑ 模擬發聲</text></svg>
<p class="caption" id="gameState">點一下遊戲區域，即可開始控制。</p></section>
<aside class="panel debug-only" id="debug"><h2>輸入設定</h2>
<button id="toggleMic" class="mic-btn">🎙️ 啟用真實麥克風</button>
<label for="inputMode">模擬方式</label><select id="inputMode"><option value="keyboard">鍵盤：按住 ↑ 發聲，放開變安靜</option><option value="slider">滑桿：手動指定持續音量</option></select>
<div class="inputbox"><label for="keyVolume">↑ 發聲時的音量 <output id="keyVolumeValue">65</output></label><input id="keyVolume" type="range" min="0" max="100" value="65"><p id="keyState" class="small">向上鍵尚未按下。</p>
<label for="simVolume">滑桿模擬音量 <output id="simVolumeValue">0</output></label><input id="simVolume" type="range" min="0" max="100" value="0" disabled><small>啟用麥克風時將優先讀取麥克風音量。</small></div>
<div class="buttons"><button id="pulse">短促一下（0.2 秒）</button><button id="silence" class="secondary">立刻安靜</button><button id="restart" class="secondary">重新遊玩</button></div>
<div class="reading"><span>目前輸入音量</span><span><strong id="raw">0</strong>／100</span></div><div class="meter" id="meter" role="meter" aria-label="音量" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"><div id="fill" class="fill"></div><span class="marker" id="quietLine"></span><span class="marker loud" id="soundLine"></span></div><div class="legend"><span id="quietLegend"></span><span id="soundLegend"></span></div>
<div class="stats"><div>發聲狀態<strong id="gateState">安靜</strong></div><div>平滑後音量<strong id="smooth">0</strong></div><div>短時間增幅<strong id="rise">0</strong></div><div>向上力量<strong id="force">0</strong></div><div>換色次數<strong id="count">0</strong></div><div>事件準備狀態<strong id="eventState">等待穩定</strong></div></div>
<h2>互動參數</h2><label for="quiet">安靜門檻 <output id="quietValue"></output></label><input id="quiet" type="range" min="0" max="90" value="20"><label for="sound">發聲門檻 <output id="soundValue"></output></label><input id="sound" type="range" min="5" max="100" value="40">
<label for="gravity">重力 <output id="gravityValue"></output></label><input id="gravity" type="range" min="30" max="350" step="10" value="120"><label for="lift">基本浮力 <output id="liftValue"></output></label><input id="lift" type="range" min="50" max="600" step="10" value="240"><label for="sensitivity">敏感度 <output id="sensitivityValue"></output></label><input id="sensitivity" type="range" min="0.2" max="2.5" step="0.1" value="1"><label for="burst">突然聲響增幅 <output id="burstValue"></output></label><input id="burst" type="range" min="5" max="40" value="12"><button id="defaults" class="secondary" style="margin-top:14px">還原互動參數</button>
<h3>最近的換色事件</h3><ol class="log" id="log"><li>尚未觸發事件。</li></ol>
</aside></div><footer class="debug-only">按下空白鍵即可開啟/關閉面板進入純遊戲模式。</footer>
<script>
'use strict';
const clamp=(n,a,b)=>Math.min(b,Math.max(a,n));
const defaults={quiet:20,sound:40,gravity:120,lift:240,sensitivity:1,burst:12};

class VoiceControl{
 constructor(){this.reset();}
 reset(){this.sounding=false;this.smoothed=null;this.history=[];this.last=null;this.cooldown=-Infinity;this.burstReady=false;this.settledSince=null;}
 tick(raw,t,p){
  if(this.last!==null&&t-this.last>250)this.reset();
  const dt=this.last===null?0:Math.max(0,(t-this.last)/1000);this.last=t;
  this.smoothed=this.smoothed===null?raw:this.smoothed+(raw-this.smoothed)*(1-Math.exp(-dt/.065));
  this.history.push({t,v:raw});while(this.history.length>1&&this.history[1].t<=t-100)this.history.shift();
  const base=this.history[0],readyWindow=t-base.t>=80,rise=readyWindow?raw-base.v:0;
  if(this.smoothed>=p.sound)this.sounding=true;else if(this.smoothed<p.quiet)this.sounding=false;
  if(rise<p.burst*.3){if(this.settledSince===null)this.settledSince=t;if(t-this.settledSince>=150)this.burstReady=true;}else this.settledSince=null;
  let event=false;if(readyWindow&&this.burstReady&&raw>=p.sound&&rise>=p.burst&&t-this.cooldown>=600){event=true;this.cooldown=t;this.burstReady=false;this.settledSince=null;}
  const intensity=this.sounding?clamp((this.smoothed-p.quiet)/Math.max(5,p.sound-p.quiet),0,2):0;
  return {volume:this.smoothed,rise,event,sounding:this.sounding,force:p.lift*p.sensitivity*intensity,eventState:t-this.cooldown<600?'冷卻中':this.burstReady?'等待突然增幅':'等待音量穩定'};
 }
}

function physics(body,dt,force,p){
 body.angle+=body.spin*dt;const angle=body.angle*Math.PI/180,extent=38*(Math.abs(Math.sin(angle))+Math.abs(Math.cos(angle)));
 body.velocity=clamp((body.velocity+(force-p.gravity)*dt)*Math.exp(-.65*dt),-400,400);
 body.height+=body.velocity*dt;
 if(body.height<extent){body.height=extent;if(body.velocity<0)body.velocity=0;}
 if(body.height>550-extent){body.height=550-extent;if(body.velocity>0)body.velocity=0;}
 return extent;
}

const $=id=>document.getElementById(id),params={...defaults},voice=new VoiceControl();
const colors=['#397866','#4b7796','#a16a40','#865e8b','#b15c62','#637d43'];
const body={height:410,velocity:0,angle:0,spin:35};
let held=false,pulseUntil=0,debug=true,lastFrame=null,lastUi=0,nextSpin=0,colorIndex=0,count=0,flashUntil=0;

let micStream=null,audioCtx=null,analyser=null,micDataArray=null,isMicActive=false;

async function initMicrophone(){
 if(isMicActive){stopMicrophone();return;}
 try{
  micStream=await navigator.mediaDevices.getUserMedia({audio:true});
  audioCtx=new(window.AudioContext||window.webkitAudioContext)();
  const source=audioCtx.createMediaStreamSource(micStream);
  analyser=audioCtx.createAnalyser();
  analyser.fftSize=512;
  source.connect(analyser);
  micDataArray=new Uint8Array(analyser.frequencyBinCount);
  isMicActive=true;
  $('toggleMic').textContent='🎙️ 關閉真實麥克風';
  $('toggleMic').classList.add('active');$('simVolume').disabled=true;
 }catch(e){
  alert('無法存取麥克風，請檢查瀏覽器權限設定。');
  isMicActive=false;
 }
}

function stopMicrophone(){
 if(micStream){micStream.getTracks().forEach(track=>track.stop());}
 if(audioCtx){audioCtx.close();}
 micStream=null;audioCtx=null;analyser=null;micDataArray=null;isMicActive=false;
 $('toggleMic').textContent='🎙️ 啟用真實麥克風';
 $('toggleMic').classList.add('active');$('toggleMic').classList.remove('active');
 if($('inputMode').value==='slider')$('simVolume').disabled=false;
}

function getRawInput(t){
 if(isMicActive&&analyser){
  analyser.getByteFrequencyData(micDataArray);
  let sum=0;
  for(let i=0;i<micDataArray.length;i++){sum+=micDataArray[i];}
  let avg=sum/micDataArray.length;
  return clamp(avg*2.2,0,100);
 }
 if(t<pulseUntil)return 95;
 const mode=$('inputMode').value;
 if(mode==='keyboard')return held?parseFloat($('keyVolume').value):0;
 if(mode==='slider')return parseFloat($('simVolume').value);
 return 0;
}

function updateUIValues(){
 ['quiet','sound','gravity','lift','sensitivity','burst','keyVolume','simVolume'].forEach(id=>{
  const el=$(id);if(el&&$(id+'Value'))$(id+'Value').textContent=el.value;
 });
 $('quietLine').style.left=params.quiet+'%';
 $('soundLine').style.left=params.sound+'\%';$('quietLegend').textContent='安靜門檻：'+params.quiet;
 $('soundLegend').textContent='發聲門檻：'+params.sound;
}

function syncParamsFromDOM(){
 ['quiet','sound','gravity','lift','sensitivity','burst'].forEach(k=>{
  params[k]=parseFloat($(k).value);
 });
 updateUIValues();
}

function logEvent(text){
 const log=$('log');
 const li=document.createElement('li');
 li.textContent=text;
 log.prepend(li);
 if(log.children.length>5)log.removeChild(log.lastChild);
}

function loop(t){
 if(!lastFrame)lastFrame=t;
 const dt=Math.min(0.1,(t-lastFrame)/1000);
 lastFrame=t;

 syncParamsFromDOM();
 const raw=getRawInput(t);
 const res=voice.tick(raw,t,params);
 const extent=physics(body,dt,res.force,params);

 if(res.event){
  count++;
  colorIndex=(colorIndex+1)%colors.length;
  $('cubeColor.style')?.fill; // dummy reference$('cubeColor').setAttribute('fill',colors[colorIndex]);
  flashUntil=t+300;
  logEvent(`[${new Date(t).toLocaleTimeString()}] 觸發換色！音量：${Math.round(raw)}`);
 }

 if(t-lastUi>80){
  lastUi=t;
  $('raw').textContent=Math.round(raw);$('fill.style').width=raw+'%';
  $('smooth').textContent=res.volume.toFixed(1);$('rise').textContent=res.rise.toFixed(1);
  $('force').textContent=Math.round(res.force);$('count').textContent=count;
  $('gateState').textContent=res.sounding?'發聲中':'安靜';
  $('gateState').style.color=res.sounding?'#b15c62':'#286a5c';
  $('eventState').textContent=res.eventState;
 }

 $('cube').setAttribute('transform',`translate(500,${650-body.height}) rotate(${body.angle})`);
 $('shadow').setAttribute('cx',500);$('shadow.style').opacity=clamp(0.05+0.15*(1-body.height/550),0.02,0.2);

 requestAnimationFrame(loop);
}

window.addEventListener('DOMContentLoaded',()=>{
 updateUIValues();
 $('toggleMic').addEventListener('click',initMicrophone);$('inputMode').addEventListener('change',e=>{
  const isSlider=(e.target.value==='slider');
  $('simVolume').disabled=isSlider&&!isMicActive?false:true;
 });
 window.addEventListener('keydown',e=>{
  if(e.code==='Space'){
   e.preventDefault();
   debug=!debug;
   document.body.classList.toggle('play',!debug);
  }
  if(e.code==='ArrowUp'){
   held=true;
   $('keyState').textContent='向上鍵已按下（發聲中）。';
   $('keyState').classList.add('active-key');
  }
 });
 window.addEventListener('keyup',e=>{
  if(e.code==='ArrowUp'){
   held=false;
   $('keyState').textContent='向上鍵尚未按下。';
   $('keyState').classList.remove('active-key');
  }
 });
 $('pulse').addEventListener('click',()=>{pulseUntil=performance.now()+200;});
 $('silence').addEventListener('click',()=>{voice.reset();held=false;pulseUntil=0;});$('restart').addEventListener('click',()=>{body.height=410;body.velocity=0;count=0;colorIndex=0;$('cubeColor').setAttribute('fill',colors[0]);voice.reset();$('log').innerHTML='<li>已重新遊玩。</li>'});
 $('defaults').addEventListener('click',()=>{
  Object.keys(defaults).forEach(k=>$(k).value=defaults[k]);
  syncParamsFromDOM();
 });
 requestAnimationFrame(loop);
});
</script>
</body></html>
